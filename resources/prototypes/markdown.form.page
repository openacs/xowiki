# -*- tcl-*-
::xowiki::Form new \
    -set name en:markdown.form \
    -title "Markdown Page" \
    -set anon_instances f \
    -set text {@_text@} \
    -set form {<form> @_name@ @_page_order@ @_title@ @_creator@ @_text@ @_description@ @_nls_language@</form>} \
    -set form_constraints {
        _text:richtext,editor=markdown
    }



